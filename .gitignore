# Models / weights (mounted at runtime, never committed)
models/

# Exported from uv.lock by `uv export`: at the repo root by the security
# workflow, per service by scripts/gen_requirements.py (run by `make
# services`). Both are derived from the committed lockfile, so neither is
# tracked.
/requirements.txt
packages/*/requirements.txt

# Generated files
*.pem
encryption.key
*.backup
coverage/
*.lcov

# Build output
dist/
build/

# Environment, config, and runtime data
.env*
!.env.example

# Logs
logs/
*.log
*.log*

# Backup and temporary files
*.bak
*.backup
*.tmp
tmp/
temp/

# Other
.ignore*/
.claude
CLAUDE.md

# E2E artifacts
**/testdata/**/*.in.*
**/testdata/**/*.out.*
**/testdata/**/*.audit.*
**/testdata/**/*.audit-*.*
