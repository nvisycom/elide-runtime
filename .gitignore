# OS
Thumbs.db
.DS_Store

# IDE and Editors
.vs/
.vscode/
.idea/
.zed/

# Rust
debug/
target/
**/*.rs.bk
*.pdb

# Python
__pycache__/
*.py[codz]
*.so
.venv/
venv/
.eggs/
*.egg-info/
wheels/

# Tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Models / weights (mounted at runtime, never committed)
models/

# Exported from each service's uv.lock by scripts/gen_requirements.py (run by
# `make requirements` and the targets that need it). Derived from the
# committed lockfile, so not tracked.
packages/*/requirements.txt

# Generated files
*.pem
encryption.key
*.backup
coverage/
*.lcov

# Build output
dist/
build/

# Environment, config, and runtime data
.env*
!.env.example

# Logs
logs/
*.log
*.log*

# Backup and temporary files
*.bak
*.backup
*.tmp
tmp/
temp/

# Other
.ignore*/
.claude
CLAUDE.md

# E2E artifacts
**/testdata/**/*.in.*
**/testdata/**/*.out.*
**/testdata/**/*.audit.*
**/testdata/**/*.audit-*.*
