{
  "$defs": {
    "Block": {
      "properties": {
        "text": {
          "title": "Text",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/BlockKind",
          "default": "text",
          "description": "Layout kind of the block."
        },
        "bbox": {
          "$ref": "#/$defs/BoundingBox"
        },
        "lines": {
          "items": {
            "$ref": "#/$defs/Line"
          },
          "title": "Lines",
          "type": "array"
        }
      },
      "required": [
        "text",
        "bbox"
      ],
      "title": "Block",
      "type": "object"
    },
    "BlockKind": {
      "description": "Layout kind of a block. Mirrors the runtime's ``BlockKind``.",
      "enum": [
        "text",
        "table",
        "figure",
        "other"
      ],
      "title": "BlockKind",
      "type": "string"
    },
    "BoundingBox": {
      "description": "Axis-aligned box in image pixels, origin top-left.",
      "properties": {
        "x": {
          "title": "X",
          "type": "number"
        },
        "y": {
          "title": "Y",
          "type": "number"
        },
        "width": {
          "minimum": 0.0,
          "title": "Width",
          "type": "number"
        },
        "height": {
          "minimum": 0.0,
          "title": "Height",
          "type": "number"
        }
      },
      "required": [
        "x",
        "y",
        "width",
        "height"
      ],
      "title": "BoundingBox",
      "type": "object"
    },
    "Line": {
      "properties": {
        "text": {
          "title": "Text",
          "type": "string"
        },
        "confidence": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence"
        },
        "bbox": {
          "$ref": "#/$defs/BoundingBox"
        },
        "polygon": {
          "anyOf": [
            {
              "maxItems": 4,
              "minItems": 4,
              "prefixItems": [
                {
                  "maxItems": 2,
                  "minItems": 2,
                  "prefixItems": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "number"
                    }
                  ],
                  "type": "array"
                },
                {
                  "maxItems": 2,
                  "minItems": 2,
                  "prefixItems": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "number"
                    }
                  ],
                  "type": "array"
                },
                {
                  "maxItems": 2,
                  "minItems": 2,
                  "prefixItems": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "number"
                    }
                  ],
                  "type": "array"
                },
                {
                  "maxItems": 2,
                  "minItems": 2,
                  "prefixItems": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "number"
                    }
                  ],
                  "type": "array"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Polygon"
        },
        "words": {
          "items": {
            "$ref": "#/$defs/Word"
          },
          "title": "Words",
          "type": "array"
        }
      },
      "required": [
        "text",
        "bbox"
      ],
      "title": "Line",
      "type": "object"
    },
    "OcrResponse": {
      "properties": {
        "pages": {
          "items": {
            "$ref": "#/$defs/Page"
          },
          "title": "Pages",
          "type": "array"
        },
        "model_id": {
          "description": "Identifier of the model that produced this result, for provenance (e.g. the engine's model name/pair). Does not encode the engine library version.",
          "title": "Model Id",
          "type": "string"
        }
      },
      "required": [
        "model_id"
      ],
      "title": "OcrResponse",
      "type": "object"
    },
    "Page": {
      "properties": {
        "page_number": {
          "description": "1-based page index.",
          "minimum": 1,
          "title": "Page Number",
          "type": "integer"
        },
        "width": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Page width in pixels.",
          "title": "Width"
        },
        "height": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Page height in pixels.",
          "title": "Height"
        },
        "blocks": {
          "items": {
            "$ref": "#/$defs/Block"
          },
          "title": "Blocks",
          "type": "array"
        }
      },
      "required": [
        "page_number"
      ],
      "title": "Page",
      "type": "object"
    },
    "Word": {
      "properties": {
        "text": {
          "title": "Text",
          "type": "string"
        },
        "confidence": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence"
        },
        "bbox": {
          "$ref": "#/$defs/BoundingBox"
        },
        "polygon": {
          "anyOf": [
            {
              "maxItems": 4,
              "minItems": 4,
              "prefixItems": [
                {
                  "maxItems": 2,
                  "minItems": 2,
                  "prefixItems": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "number"
                    }
                  ],
                  "type": "array"
                },
                {
                  "maxItems": 2,
                  "minItems": 2,
                  "prefixItems": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "number"
                    }
                  ],
                  "type": "array"
                },
                {
                  "maxItems": 2,
                  "minItems": 2,
                  "prefixItems": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "number"
                    }
                  ],
                  "type": "array"
                },
                {
                  "maxItems": 2,
                  "minItems": 2,
                  "prefixItems": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "number"
                    }
                  ],
                  "type": "array"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "4-point polygon, present when the engine reports rotated regions.",
          "title": "Polygon"
        }
      },
      "required": [
        "text",
        "bbox"
      ],
      "title": "Word",
      "type": "object"
    }
  },
  "description": "One response per input image, in request order.",
  "items": {
    "$ref": "#/$defs/OcrResponse"
  },
  "title": "OcrOutput",
  "type": "array",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
