# Copy to .env and edit. Every value here is the compose default, so an
# unedited copy behaves exactly as `docker compose up` with no .env at all.

# Image tag to run. Pin this in production: `latest` moves.
#
# Defaults to a prerelease because no `latest` exists yet — every tag so far
# is a release candidate, and a prerelease deliberately does not move
# `latest` (see .github/workflows/docker.yml). Switch this to `latest` once
# a non-prerelease version ships.
ELIDE_VERSION=0.1.0-rc.4

# Published images. Override to pull from a mirror or a private registry.
ELIDE_NER_IMAGE=ghcr.io/nvisycom/elide-ner
ELIDE_OCR_IMAGE=ghcr.io/nvisycom/elide-ocr
ELIDE_STT_IMAGE=ghcr.io/nvisycom/elide-stt

# Host ports, only for reaching a service from outside the compose network.
# Each service listens on 3000 inside its container, and a server on the same
# network reaches them as ner:3000, ocr:3000, stt:3000 regardless of these.
#
# Starting at 3100 rather than 3000: 3000 is a common default for a local web
# dev server, and if one holds the port a request to localhost:3000 reaches it
# instead of the NER service.
ELIDE_NER_PORT=3100
ELIDE_OCR_PORT=3101
ELIDE_STT_PORT=3102

# INFO, DEBUG, WARNING, ERROR. The services log request ids and counts only,
# never input text or extracted spans, at any level.
ELIDE_LOG_LEVEL=INFO

# --- Models -----------------------------------------------------------------
# The per-service *-init containers fetch these into the shared cache volumes
# before the services start. Changing one means the next `up` re-warms its
# cache.
#
# Model licenses are the operator's responsibility. The defaults below are
# Apache-2.0 (NER, OCR) and MIT (STT).

# NER: SOTA PII span-F1, Apache-2.0, 7 languages.
ELIDE_NER_MODEL=fastino/gliner2-privacy-filter-PII-multi
# Load fp16 instead of fp32, roughly halving the ~1.2 GB resident footprint.
ELIDE_NER_QUANTIZE=
# Inputs over this many tokens are rejected, not truncated, so PII past the
# limit is never silently dropped. 512 is the encoder's own limit.
ELIDE_NER_MAX_TOKENS=512

# OCR: docTR 'detection+recognition' pair, both Apache-2.0.
ELIDE_OCR_MODEL=db_resnet50+crnn_vgg16_bn

# STT: a faster-whisper size alias or an explicit repo id. The `large-v3-turbo`
# alias currently resolves to dropbox-dash/faster-whisper-large-v3-turbo (MIT);
# pin the repo id directly if you need that resolution to stay fixed.
ELIDE_STT_MODEL=large-v3-turbo
ELIDE_STT_DEVICE=cpu
# Empty lets faster-whisper choose for the device (int8 on CPU, float16 on GPU).
ELIDE_STT_COMPUTE_TYPE=

# --- Diarization (off by default) -------------------------------------------
# The diarization model is GATED on the Hugging Face Hub: it cannot be
# redistributed in an image, and downloading it requires accepting its terms.
# To enable:
#   1. accept the terms at
#      https://huggingface.co/pyannote/speaker-diarization-community-1
#   2. create a token on that same account
#   3. set both values below
# stt-init fails with that instruction if the flag is on and the token is
# missing, rather than letting the service fail its healthcheck later.
ELIDE_STT_DIARIZE=false
ELIDE_STT_DIARIZE_MODEL=pyannote/speaker-diarization-community-1
ELIDE_STT_HF_TOKEN=
